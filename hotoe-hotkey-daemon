#!/usr/bin/env python3
import sys, zmq, time

HOTKEY_BUS_ADDR = "ipc://hotoe-hotkeys-in.ipc"

def main():
    if len(sys.argv) < 2:
        print("usage: hotoe-hotkey-daemon <combo>", file=sys.stderr)
        sys.exit(1)

    combo = sys.argv[1]  # e.g. "SUPER+D", "CTRL+SHIFT+K"

    ctx = zmq.Context()
    sock = ctx.socket(zmq.PUB)
    sock.connect(HOTKEY_BUS_ADDR)
    time.sleep(0.05)  # let the connect settle before publishing
    sock.send_string(combo)
    sock.close()
    ctx.term()

if __name__ == "__main__":
    main()
